{
  "name": "box-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "BOX 顶层工作区：代码在 code/，资源类在 resources/。这里只做命令转发，依赖装在 code/。",
  "scripts": {
    "install:code": "npm --prefix code install",
    "ci:code": "npm --prefix code ci",
    "dev": "npm --prefix code run dev",
    "build": "npm --prefix code run build",
    "start": "npm --prefix code run start",
    "lint": "npm --prefix code run lint",
    "sync:edh-cards": "npm --prefix code run sync:edh-cards",
    "build:kards": "npm --prefix code run build:kards",
    "db:generate": "npm --prefix code run db:generate",
    "db:migrate": "npm --prefix code run db:migrate",
    "db:import-json": "npm --prefix code run db:import-json",
    "db:migrate-runtime-json": "npm --prefix code run db:migrate-runtime-json",
    "db:migrate-dnd-save": "npm --prefix code run db:migrate-dnd-save",
    "db:setup": "npm --prefix code run db:setup",
    "smoke:dnd-merge": "npm --prefix code run smoke:dnd-merge",
    "smoke:dnd-sync": "npm --prefix code run smoke:dnd-sync"
  }
}
