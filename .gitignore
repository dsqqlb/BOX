# Lock files (optional, 取消注释以忽略)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# 资源类：运行时数据（SQLite、账户文件、上传、缓存、迁移备份、用户站点）。
# 只存在于本地/服务器，绝不提交。
/resources/data/

# 资源类：本地图片资源（DND 怪物图等，约 700 MB），由本地维护、随共享目录单独上传
/resources/public/image/
/resources/public/icons/

# 命令行类：本地验证脚本产物
/ops/checks/shots/

# 命令行类：本地启动脚本
/ops/RUN.bat

# 命令行类：发布包暂存目录（由 ops/release/package-and-upload.ps1 生成）
/ops/.release/

# 命令行类：日志
/ops/logs/*.log
