<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.box.autodeploy</string>

    <!--
      下面的路径含有占位符 __PROJECT_DIR__，安装时请替换成项目在Mac mini上的实际绝对路径，
      例如 /Users/yourname/BOX。可以直接用 sed 替换，见 DEPLOYMENT.md 里的安装步骤。
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/mac-mini/auto-deploy-poll.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- 开机自动启动，且如果进程意外退出会自动重启 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 轮询间隔（秒），需要时可以在这里调整，改完要重新 launchctl unload/load 才生效 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>POLL_INTERVAL</key>
        <string>60</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 日志输出位置，方便排查自动部署有没有正常工作 -->
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/mac-mini/autodeploy.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/mac-mini/autodeploy.error.log</string>
</dict>
</plist>
