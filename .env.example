# 环境变量配置模板

# 当需要添加后端功能时，复制此文件为 .env.local 并填入实际值

# Claude API (如果需要调用 Claude API)
# ANTHROPIC_API_KEY=your_api_key_here

# 数据库 (如果使用 PocketBase)
# NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# 数据库 (如果使用 PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/box

# 其他 API Keys
# OPENAI_API_KEY=your_openai_key
