# 环境变量配置模板

# ============ WebSocket地址配置（二选一，不要同时设置） ============

# 方式A：Cloudflare Tunnel / 只暴露单端口的反向代理场景（推荐，见 DEPLOYMENT.md 的 Tunnel 部署章节）
# 设为 true 后，前端会用 wss://<当前域名>/ws 连接，由nginx按路径转发给WebSocket服务，
# 不需要单独为WebSocket开一条隧道规则。box.dsqqlb.top 场景下用这个。
NEXT_PUBLIC_WS_PATH_MODE=true

# 方式B：完全自定义地址（优先级高于方式A，两者都设置时以这个为准）
# NEXT_PUBLIC_WS_URL=wss://ws.yourdomain.com

# 当需要添加后端功能时，复制此文件为 .env.local 并填入实际值

# Claude API (如果需要调用 Claude API)
# ANTHROPIC_API_KEY=your_api_key_here

# 数据库 (如果使用 PocketBase)
# NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# 数据库 (如果使用 PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/box

# 其他 API Keys
# OPENAI_API_KEY=your_openai_key
