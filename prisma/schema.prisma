generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(cuid())
  username    String           @unique
  passwordHash String
  sessionRevision Int @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions UserPermission[]
  decks       Deck[]
  kardsDecks  KardsDeck[]
  dndSave     DndSave?
  savings     SavingsRecord[]
  homePreference HomePreference?
  homeToolUsage  HomeToolUsage[]
  chatMessages   ChatMessage[]
  chatAttachments ChatAttachment[]
  chatReactions  ChatReaction[]
}

model HomePreference {
  ownerId                 String   @id
  favoriteToolSlugsJson   String   @default("[]")
  toolOrderJson           String   @default("[]")
  collapsedCategoriesJson String   @default("[]")
  theme                   String   @default("midnight")
  viewMode                String   @default("grid")
  updatedAt               DateTime @updatedAt
  owner                   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model HomeToolUsage {
  ownerId      String
  toolSlug     String
  lastOpenedAt DateTime
  openCount    Int      @default(1)
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, toolSlug])
  @@index([ownerId, lastOpenedAt])
}

model ChatMessage {
  id          String           @id @default(cuid())
  authorId    String
  body        String           @default("")
  replyToId   String?
  createdAt   DateTime         @default(now())
  withdrawnAt DateTime?
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     ChatMessage?     @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[]    @relation("ChatReplies")
  attachments ChatAttachment[]
  reactions   ChatReaction[]

  @@index([createdAt, id])
  @@index([authorId, createdAt])
}

model ChatAttachment {
  id           String       @id @default(cuid())
  messageId    String?
  uploaderId   String
  storedName   String       @unique
  originalName String
  mimeType     String
  byteSize     Int
  createdAt    DateTime     @default(now())
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId, createdAt])
}

model ChatReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId, createdAt])
}

model UserPermission {
  userId     String
  permission String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
}

model Deck {
  id                 String     @id
  ownerId            String
  name               String
  commanderOracleId  String?
  layoutJson         String?
  createdAt          DateTime
  updatedAt          DateTime
  owner              User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cards              DeckCard[]

  @@index([ownerId, updatedAt])
}

model DeckCard {
  deckId   String
  oracleId String
  quantity Int
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([deckId, oracleId])
}

model KardsDeck {
  id        String   @id
  ownerId   String
  name      String
  faction   String?
  cardsJson String
  createdAt DateTime
  updatedAt DateTime
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
}

model DndSave {
  ownerId   String   @unique
  dataJson  String
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model SavingsRecord {
  id        String   @id
  ownerId   String
  date      String
  time      String
  activity  String
  item      String
  amount    Float
  createdAt DateTime
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}
