generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(cuid())
  username    String           @unique
  passwordHash String
  sessionRevision Int @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions UserPermission[]
  decks       Deck[]
  kardsDecks  KardsDeck[]
  dndSave     DndSave?
  savings     SavingsRecord[]
  carcassonneSaves CarcassonneSave[]
  homePreference HomePreference?
  homeToolUsage  HomeToolUsage[]
  dailyToolUsage DailyToolUsage[]
  chatMessages   ChatMessage[]
  chatAttachments ChatAttachment[]
  chatReactions  ChatReaction[]
  createdMedicineProducts MedicineProduct[] @relation("MedicineProductCreator")
  medicineUseLogs MedicineUseLog[]
  uploadedSceneMedia DndSceneMedia[]
  holdemBalance  HoldemBalance?
  holdemLedger   HoldemLedger[]
}

model HoldemBalance {
  ownerId     String   @id
  chips       Int      @default(10000)
  handsPlayed Int      @default(0)
  handsWon    Int      @default(0)
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model HoldemLedger {
  id        String   @id @default(cuid())
  ownerId   String
  delta     Int
  balance   Int
  kind      String
  roomId    String?
  note      String?
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model HomePreference {
  ownerId                 String   @id
  favoriteToolSlugsJson   String   @default("[]")
  toolOrderJson           String   @default("[]")
  collapsedCategoriesJson String   @default("[]")
  theme                   String   @default("midnight")
  viewMode                String   @default("grid")
  updatedAt               DateTime @updatedAt
  owner                   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model HomeToolUsage {
  ownerId      String
  toolSlug     String
  lastOpenedAt DateTime
  openCount    Int      @default(1)
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, toolSlug])
  @@index([ownerId, lastOpenedAt])
}

model DailyToolUsage {
  ownerId    String
  toolSlug   String
  dayKey     String
  openCount  Int      @default(1)
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, toolSlug, dayKey])
  @@index([ownerId, dayKey])
}

model ChatMessage {
  id          String           @id @default(cuid())
  authorId    String
  body        String           @default("")
  replyToId   String?
  createdAt   DateTime         @default(now())
  withdrawnAt DateTime?
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     ChatMessage?     @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[]    @relation("ChatReplies")
  attachments ChatAttachment[]
  reactions   ChatReaction[]

  @@index([createdAt, id])
  @@index([authorId, createdAt])
}

model ChatAttachment {
  id           String       @id @default(cuid())
  messageId    String?
  uploaderId   String
  storedName   String       @unique
  originalName String
  mimeType     String
  byteSize     Int
  createdAt    DateTime     @default(now())
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId, createdAt])
}

model ChatReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId, createdAt])
}

model MedicineProduct {
  id           String          @id @default(cuid())
  name         String
  genericName  String?
  brand        String?
  category     String
  dosageForm   String?
  specification String?
  manufacturer String?
  origin       String?
  approvalNumber String?
  purpose      String?
  precautions  String?
  notes        String?
  creatorId    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  creator      User            @relation("MedicineProductCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  batches      MedicineBatch[]
  photos       MedicinePhoto[]

  @@index([updatedAt])
  @@index([category, updatedAt])
}

model MedicineBatch {
  id              String          @id @default(cuid())
  productId       String
  batchNumber     String?
  productionDate  DateTime?
  expiryDate      DateTime?
  initialQuantity Float
  remainingQuantity Float
  unit            String
  storageLocation String?
  receivedAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         MedicineProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  useLogs         MedicineUseLog[]

  @@index([productId, expiryDate])
  @@index([expiryDate])
}

model MedicineUseLog {
  id           String        @id @default(cuid())
  batchId      String
  operatorId   String
  usedQuantity Float
  usedAt       DateTime      @default(now())
  recipient    String?
  reason       String?
  note         String?
  createdAt    DateTime      @default(now())
  batch        MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  operator     User          @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([batchId, usedAt])
  @@index([usedAt])
}

model MedicinePhoto {
  id           String          @id @default(cuid())
  productId    String
  storedName   String          @unique
  originalName String
  mimeType     String
  byteSize     Int
  createdAt    DateTime        @default(now())
  product      MedicineProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model DndSceneMedia {
  id           String   @id @default(cuid())
  uploaderId   String
  storedName   String   @unique
  originalName String
  mimeType     String
  kind         String
  byteSize     Int
  createdAt    DateTime @default(now())
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([kind, createdAt])
  @@index([uploaderId, createdAt])
}

model UserPermission {
  userId     String
  permission String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
}

model Deck {
  id                 String     @id
  ownerId            String
  name               String
  commanderOracleId  String?
  layoutJson         String?
  createdAt          DateTime
  updatedAt          DateTime
  owner              User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cards              DeckCard[]

  @@index([ownerId, updatedAt])
}

model DeckCard {
  deckId   String
  oracleId String
  quantity Int
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([deckId, oracleId])
}

model KardsDeck {
  id        String   @id
  ownerId   String
  name      String
  faction   String?
  cardsJson String
  createdAt DateTime
  updatedAt DateTime
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
}

model DndSave {
  ownerId   String   @unique
  dataJson  String
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model SavingsRecord {
  id        String   @id
  ownerId   String
  date      String
  time      String
  activity  String
  item      String
  amount    Float
  createdAt DateTime
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model CarcassonneSave {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  stateJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}
